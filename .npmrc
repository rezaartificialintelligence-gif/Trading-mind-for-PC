auto-install-peers=false
strict-peer-dependencies=false

# Include native binaries for all platforms in lockfile
# Fixes: Cannot find module @rollup/rollup-win32-x64-msvc on GitHub Actions Windows runners
supportedArchitectures[]=current
supportedArchitectures[]=x64
supportedArchitectures[]=arm64
supportedArchitectures[]=linux
supportedArchitectures[]=win32
supportedArchitectures[]=darwin
